<root BTCPP_format="4">
  <!-- Generated by model: gpt-4o -->
  <BehaviorTree ID="MainTree">
    <RetryUntilSuccessful num_attempts="5">
      <Sequence name="capture_order_sequence">
        <!-- <NavigateTo target="{detected_customer}"/> -->
        
        <Speak text="Hello, welcome to our restaurant!"/>
        
        <Speak text="Today's menu includes pizza, steak, salad for food; water, wine for drinks; and ice cream, cake for desserts."/>
        
        <AskOpenQuestion question="What would you like to order?" answer="{full_order}"/>
        
        <Sequence name="extract_order_details">
          <Extract interest="main_dish" text="{full_order}" extracted_info="{main_dish}"/>
          <Extract interest="drink" text="{full_order}" extracted_info="{drink}"/>
          <Extract interest="dessert" text="{full_order}" extracted_info="{dessert}"/>
        </Sequence>
        
        <Sequence name="confirm_order">
          <Speak text="You have ordered the following:"/>
          <Speak text="{main_dish}"/>
          <Speak text="{drink}"/>
          <Speak text="{dessert}"/>
          <Speak text="Is that correct?"/>
        </Sequence>
        
        <Fallback name="order_confirmation_fallback">
          <Sequence>
            <AskYesNoQuestion question="Is your order correct?" confirmed="{order_correct}"/>
            <Speak text="Thank you for your order! Enjoy your meal!"/>
            <Speak text="Goodbye!"/>
          </Sequence>
          <Sequence>
            <Speak text="I'm sorry for the mistake. Let's try again."/>
            <ForcePlanFail fail_message="Order confirmation failed after retries."/>
            <Speak text="Goodbye!"/>
          </Sequence>
        </Fallback>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>